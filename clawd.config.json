{
  "$comment": "Each entry in scenes becomes assets/<name>.svg. Run: npm run build. Every option is documented in README.md.",
  "outDir": "assets",
  "scenes": {
    "walk": {
      "height": 130,
      "clawds": [
        { "animation": "walk", "say": "hi!", "walk": { "duration": 14, "stopAt": 0.5, "trick": "flip" } }
      ]
    },
    "divider": {
      "height": 56,
      "ground": { "style": "solid", "width": 2, "y": 48 },
      "clawds": [
        { "size": 4, "pose": "sit", "animation": "bounce", "shadow": false, "hopHeight": 12 }
      ]
    },
    "sitting": {
      "height": 150,
      "ground": { "style": "dotted" },
      "clawds": [
        { "x": "18%", "pose": "sit", "accessories": ["glasses", "book"], "say": ["reading docs", "RTFM!"], "sayEvery": 3 },
        { "x": "50%", "pose": "sit", "accessories": ["laptop"], "say": ["git push", "tests pass ✓", "ship it"], "sayEvery": 2.5, "delay": 0.8 },
        { "x": "82%", "pose": "sit", "accessories": ["party"], "eyes": "happy", "say": ["Vibing…", "Wibbling…"], "sayEvery": 3, "delay": 1.6 }
      ]
    },
    "status": {
      "height": 90,
      "status": { "x": 110, "y": 52, "verbs": "claude", "count": 16 },
      "clawds": [
        { "x": 50, "pose": "sit", "accessories": ["laptop"], "animation": "idle", "shadow": false }
      ],
      "ground": { "style": "none", "y": 78 }
    },
    "banner": {
      "height": 170,
      "background": { "light": "#fdf6ec", "dark": "#1a1a17", "radius": 14 },
      "theme": { "light": { "ground": "#3d3929" }, "dark": { "ground": "#8b949e" } },
      "decor": [
        { "type": "cloud", "x": "48%", "y": 22 },
        { "type": "flower", "x": "74%" },
        { "type": "flower", "x": "86%", "scale": 1.3 },
        { "type": "sparkle", "x": "30%", "y": 30, "delay": 0.4 },
        { "type": "sparkle", "x": "92%", "y": 30, "scale": 0.7, "delay": 1.3 }
      ],
      "texts": [
        { "text": ["hello, world", "welcome to my profile", "made with Claude Code"], "x": "55%", "y": 80, "size": 20, "typing": true, "every": 3.5 }
      ],
      "clawds": [
        { "animation": "walk", "size": 7, "say": "hey!", "walk": { "duration": 16, "stopAt": 0.12, "trick": "hop" } }
      ]
    },
    "party": {
      "height": 140,
      "decor": [
        { "type": "sparkle", "x": "30%", "y": 26 },
        { "type": "sparkle", "x": "70%", "y": 34, "delay": 0.8 }
      ],
      "clawds": [
        { "x": "35%", "accessories": ["party"], "animation": "dance", "eyes": "happy" },
        { "x": "50%", "accessories": ["crown"], "animation": "hop", "eyes": "sparkly", "say": "yay!", "delay": 0.2 },
        { "x": "65%", "accessories": ["tophat"], "animation": "dance", "eyes": "happy", "delay": 0.5 }
      ]
    },
    "sleepy": {
      "height": 110,
      "clawds": [
        { "x": "50%", "pose": "sit", "animation": "sleep" }
      ]
    },
    "wave": {
      "height": 120,
      "clawds": [
        { "x": "50%", "animation": "wave", "say": ["hello!", "thanks for visiting"], "sayEvery": 3 }
      ]
    }
  }
}
